import requests
from requests.auth import HTTPBasicAuth

BASE_URL = "https://qualysapi.qg2.apps.qualys.com"

USERNAME = "YOUR_USERNAME"
PASSWORD = "YOUR_PASSWORD"

url = f"{BASE_URL}/api/2.0/fo/asset/host/vm/detection/"

params = {
    "action": "list",
    "status": "Active,Fixed",
    "truncation_limit": "10"
}

headers = {
    "X-Requested-With": "Python"
}

response = requests.get(
    url,
    params=params,
    headers=headers,
    auth=HTTPBasicAuth(USERNAME, PASSWORD),
    timeout=120
)

print("Request URL:")
print(response.url)

print("\nHTTP Status:")
print(response.status_code)

print("\nResponse:")
print(response.text[:10000])
