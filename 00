import requests
from requests.auth import HTTPBasicAuth

QUALYS_BASE_URL = "https://qualysapi.qg2.apps.qualys.com"

USERNAME = "your_username"
PASSWORD = "your_password"

url = f"{QUALYS_BASE_URL}/api/2.0/fo/asset/host/vm/detection/"

params = {
    "action": "list",
    "truncation_limit": "10"
}

headers = {
    "X-Requested-With": "Python"
}

response = requests.get(
    url,
    params=params,
    headers=headers,
    auth=HTTPBasicAuth(USERNAME, PASSWORD),
    timeout=60
)

print("Request URL:")
print(response.url)

print("\nHTTP Status:")
print(response.status_code)

print("\nResponse:")
print(response.text)
