# ============================================================
# 5. Find Incident by Number
# ============================================================

def get_incident(incident_number):

    records = get_records(
        table="incident",
        query=f"number={incident_number}",
        fields=[
            "sys_id",
            "number",
            "short_description",
            "assignment_group"
        ],
        limit=1
    )

    if not records:
        raise ValueError(f"Incident {incident_number} not found")

    return records[0]


# ============================================================
# 6. Assignment Group Change History
# ============================================================

def get_assignment_group_history(incident_number):

    incident = get_incident(incident_number)

    incident_sys_id = incident["sys_id"]

    print(f"\nIncident: {incident_number}")
    print(f"Description: {incident.get('short_description')}")
    print(f"Current Group: {incident.get('assignment_group')}")
    print(f"Sys ID: {incident_sys_id}")

    # sys_audit contains field-level change history
    audit_records = get_records(
        table="sys_audit",
        query=(
            f"documentkey={incident_sys_id}"
            "^fieldname=assignment_group"
            "^ORDERBYsys_created_on"
        ),
        fields=[
            "sys_id",
            "sys_created_on",
            "user",
            "oldvalue",
            "newvalue"
        ],
        limit=1000
    )

    return audit_records


# ============================================================
# Display assignment group history
# ============================================================

def show_assignment_group_history(incident_number):

    history = get_assignment_group_history(incident_number)

    print("\n==========================================")
    print("ASSIGNMENT GROUP CHANGE HISTORY")
    print("==========================================")

    if not history:
        print("No assignment group changes found.")
        return

    for i, change in enumerate(history, start=1):

        print(f"\nChange #{i}")
        print(f"Date : {change.get('sys_created_on')}")
        print(f"User : {change.get('user')}")
        print(f"From : {change.get('oldvalue')}")
        print(f"To   : {change.get('newvalue')}")

    print("\n------------------------------------------")
    print(f"Total assignment group changes: {len(history)}")
    print("------------------------------------------")


# ============================================================
# Pretty Print Records
# ============================================================

def print_records(title, records):

    print(f"\n{'=' * 70}")
    print(title)
    print("=" * 70)

    for record in records:

        print(
            f"{record.get('number', ''):<15} "
            f"{record.get('state', ''):<15} "
            f"{str(record.get('assignment_group', '')):<30} "
            f"{record.get('short_description', '')}"
        )


