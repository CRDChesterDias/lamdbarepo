# ==========================================================
# FORMAT SUMMARY SHEET
# ==========================================================

wb = load_workbook(output_file)

ws = wb["Summary"]


# ----------------------------------------------------------
# Page title
# ----------------------------------------------------------

ws.merge_cells("B2:H3")

title_cell = ws["B2"]

title_cell.value = "Windows Server Patch Compliance"

title_cell.font = Font(
    size=22,
    bold=True
)

title_cell.alignment = Alignment(
    horizontal="center",
    vertical="center"
)


# ==========================================================
# KPI CARDS
# ==========================================================

# Total
ws["B5"] = "Total Servers"
ws["B6"] = total_count

# Patched
ws["D5"] = "Patched"
ws["D6"] = patched_count
ws["D7"] = f"{patched_pct:.1f}%"

# Unpatched
ws["F5"] = "Unpatched"
ws["F6"] = unpatched_count
ws["F7"] = f"{unpatched_pct:.1f}%"

# Pending reboot
ws["H5"] = "Pending Reboot"
ws["H6"] = pending_count
ws["H7"] = f"{pending_pct:.1f}%"


# ----------------------------------------------------------
# KPI heading formatting
# ----------------------------------------------------------

for cell in [
    "B5",
    "D5",
    "F5",
    "H5"
]:

    ws[cell].font = Font(
        bold=True,
        size=12
    )

    ws[cell].alignment = Alignment(
        horizontal="center"
    )


# ----------------------------------------------------------
# KPI number formatting
# ----------------------------------------------------------

for cell in [
    "B6",
    "D6",
    "F6",
    "H6"
]:

    ws[cell].font = Font(
        bold=True,
        size=22
    )

    ws[cell].alignment = Alignment(
        horizontal="center"
    )


# Percentage formatting
for cell in [
    "D7",
    "F7",
    "H7"
]:

    ws[cell].font = Font(
        bold=True,
        size=12
    )

    ws[cell].alignment = Alignment(
        horizontal="center"
    )


# ==========================================================
# OPTIONAL KPI BACKGROUNDS
# ==========================================================

# Patched
for row in range(5, 8):
    ws[f"D{row}"].fill = PatternFill(
        "solid",
        fgColor="E2F0D9"
    )

# Unpatched
for row in range(5, 8):
    ws[f"F{row}"].fill = PatternFill(
        "solid",
        fgColor="FCE4D6"
    )

# Pending reboot
for row in range(5, 8):
    ws[f"H{row}"].fill = PatternFill(
        "solid",
        fgColor="FFF2CC"
    )

# Total
for row in range(5, 8):
    ws[f"B{row}"].fill = PatternFill(
        "solid",
        fgColor="D9EAF7"
    )


# ==========================================================
# INSERT CHART IMAGE
# ==========================================================

img = Image(chart_file)

img.width = 800
img.height = 480

ws.add_image(
    img,
    "B10"
)


# ==========================================================
# COLUMN WIDTHS
# ==========================================================

for column in range(1, 11):

    ws.column_dimensions[
        get_column_letter(column)
    ].width = 15


# Make KPI columns wider
for column in ["B", "D", "F", "H"]:
    ws.column_dimensions[column].width = 20


# ==========================================================
# SAVE
# ==========================================================

wb.save(output_file)

print(f"Created: {output_file}")
