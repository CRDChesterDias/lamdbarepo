import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

from openpyxl import load_workbook
from openpyxl.drawing.image import Image
from openpyxl.styles import Font, PatternFill, Alignment
from openpyxl.utils import get_column_letter


# ==========================================================
# COUNTS
# ==========================================================

patched_count = fixed_df["hostname"].nunique()

unpatched_count = unpatched_df["hostname"].nunique()

pending_count = pending_reboot_df["hostname"].nunique()

total_count = (
    patched_count
    + unpatched_count
    + pending_count
)


# ==========================================================
# PERCENTAGES
# ==========================================================

patched_pct = (
    patched_count / total_count * 100
    if total_count else 0
)

unpatched_pct = (
    unpatched_count / total_count * 100
    if total_count else 0
)

pending_pct = (
    pending_count / total_count * 100
    if total_count else 0
)


# ==========================================================
# CREATE CHART
# ==========================================================

chart_df = pd.DataFrame({
    "Patch Status": [
        "Patched",
        "Unpatched",
        "Pending Reboot"
    ],
    "Server Count": [
        patched_count,
        unpatched_count,
        pending_count
    ]
})

chart_df["Percentage"] = (
    chart_df["Server Count"] /
    total_count * 100
)

sns.set_theme(
    style="whitegrid",
    context="talk"
)

plt.figure(figsize=(10, 6))

ax = sns.barplot(
    data=chart_df,
    x="Patch Status",
    y="Server Count"
)


# ----------------------------------------------------------
# Add labels
# ----------------------------------------------------------

for container in ax.containers:

    labels = []

    for bar, (_, row) in zip(
        container,
        chart_df.iterrows()
    ):

        labels.append(
            f'{int(row["Server Count"])}\n'
            f'({row["Percentage"]:.1f}%)'
        )

    ax.bar_label(
        container,
        labels=labels,
        padding=8,
        fontsize=11,
        fontweight="bold"
    )


ax.set_title(
    "Windows Server Patch Compliance",
    fontsize=18,
    fontweight="bold",
    pad=20
)

ax.set_xlabel("")
ax.set_ylabel("Number of Servers")

ax.set_ylim(
    0,
    chart_df["Server Count"].max() * 1.20
)

sns.despine()

plt.tight_layout()

chart_file = "windows_patch_compliance.png"

plt.savefig(
    chart_file,
    dpi=200,
    bbox_inches="tight"
)

plt.close()


